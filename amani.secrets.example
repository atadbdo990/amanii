# ══════════════════════════════════════════════════════════════
#  Amani — local secrets TEMPLATE
#
#  1. cp amani.secrets.example amani.secrets
#  2. chmod 600 amani.secrets
#  3. fill in your values
#
#  amani.secrets is in .gitignore — this template is NOT.
#  Never put a real token in this file.
# ══════════════════════════════════════════════════════════════

# Your bot from @BotFather → format: 123456789:AbCdefGHIjklMNOpqrSTUvwxYZ
: "${BOT_TOKEN:=}"

# Numeric user ID, group ID (-100xxxxxxxxxx), or @channelname
: "${CHAT_ID:=}"

# Optional: pin a fixed password/UUID for servers YOU run.
# Leave empty for auto-generated (safe for distribution).
: "${PASSWORD:=}"
